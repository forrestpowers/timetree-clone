# cloudflared forwards https://<your domain> to http://<this machine>:80.
# Cloudflare terminates TLS, so Caddy serves plain HTTP. It answers for any
# hostname (only the tunnel reaches it) and passes the original Host header
# through, which the app uses to build its URLs.
:80 {
	# Don't compress the live-update stream: compression would buffer it
	@compressible not path /api/stream
	encode @compressible zstd gzip

	reverse_proxy app:3000 {
		# Send server-sent events to the browser immediately
		flush_interval -1
	}

	# Make installed phones pick up new versions promptly
	@sw path /service-worker.js
	header @sw Cache-Control "no-cache"
}
